{
  "name": "Game Pals",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "npm install -g pnpm@10 @anthropic-ai/claude-code && pnpm install",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Game Pals (Vite)",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["vitest.explorer", "esbenp.prettier-vscode"]
    }
  },
  "hostRequirements": {
    "cpus": 2
  }
}
